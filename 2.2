# INSERTs til bil

inserts_bil <- apply(
  df1[, c("carid","details","makemodel","description","location","link")],
  1,
  function(x) {
    sprintf(
      "INSERT INTO bil (carid, details, makemodel, description, location, link)
       VALUES ('%s','%s','%s','%s','%s','%s');",
      gsub("'", "''", x[1]),
      gsub("'", "''", x[2]),
      gsub("'", "''", x[3]),
      gsub("'", "''", x[4]),
      gsub("'", "''", x[5]),
      gsub("'", "''", x[6])
    )
  }
)

writeLines(inserts_bil, "INSERT_bil.sql")


# INSERTs til variabel

